# =============================================================================
# API Service — FastAPI
# =============================================================================
FROM python:3.12-slim AS base

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    libmagic1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------------------------------------------------------------------------
# Dependencies layer (cached unless requirements change)
# ---------------------------------------------------------------------------
FROM base AS deps

COPY requirements/base.txt requirements/api.txt ./requirements/
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements/base.txt \
    && pip install --no-cache-dir -r requirements/api.txt

# ---------------------------------------------------------------------------
# Runtime layer
# ---------------------------------------------------------------------------
FROM deps AS runtime

# Non-root user for security
RUN useradd -m -u 1000 appuser

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000

# Pre-download HuggingFace models at build time (optional — set HF_HUB_TOKEN)
# RUN python -c "from FlagEmbedding import BGEM3FlagModel; BGEM3FlagModel('BAAI/bge-m3')"

CMD ["uvicorn", "src.adapters.api.app:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--log-config", "docker/logging.json"]
