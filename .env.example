# =============================================================================
# RAG Ingestion Pipeline — Environment Configuration
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# =============================================================================

# --- App ---
APP_NAME=rag-ingestion-pipeline
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=["http://localhost:3000"]
API_KEY=CHANGE_ME_STRONG_RANDOM_KEY
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_UPLOAD_SIZE_MB=500

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_pipeline
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_DLQ=2
REDIS_TTL_SECONDS=3600

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-documents
MINIO_BUCKET_PROCESSED=processed-documents
MINIO_BUCKET_DLQ=dlq-documents

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=true
QDRANT_DEFAULT_DENSE_SIZE=1024

# --- Ollama (LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CLASSIFIER_MODEL=llama3.1:8b
OLLAMA_CHUNKER_MODEL=llama3.1:8b
OLLAMA_NER_MODEL=llama3.1:8b
OLLAMA_SUMMARIZER_MODEL=llama3.1:8b
OLLAMA_PII_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# --- HuggingFace ---
HF_DENSE_EMBEDDING_MODEL=BAAI/bge-m3
HF_DENSE_EMBEDDING_DEVICE=cpu
HF_DENSE_BATCH_SIZE=32
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_NER_MODEL=dslim/bert-base-NER
HF_LANGUAGE_MODEL=papluca/xlm-roberta-base-language-detection
HF_CACHE_DIR=/models/huggingface
HF_HUB_TOKEN=

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_QUEUE_NAME=ingestion
WORKER_DLQ_NAME=ingestion_dlq
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_TASK_TIMEOUT_SECONDS=600
WORKER_CHECKPOINTER_BACKEND=postgres

# --- Chunking ---
CHUNKING_LLM_DRIVEN=true
CHUNKING_FALLBACK_STRATEGY=recursive
CHUNKING_FIXED_CHUNK_SIZE=512
CHUNKING_FIXED_CHUNK_OVERLAP=64
CHUNKING_SEMANTIC_BREAKPOINT_THRESHOLD=0.85
CHUNKING_MIN_CHUNK_SIZE=50
CHUNKING_MAX_CHUNK_SIZE=2048

# --- Processing ---
PROCESSING_ENABLE_NER=true
PROCESSING_ENABLE_SUMMARIZATION=true
PROCESSING_ENABLE_DEDUPLICATION=true
PROCESSING_ENABLE_LANGUAGE_DETECTION=true
PROCESSING_ENABLE_PII_REDACTION=true
PROCESSING_DEDUP_THRESHOLD=0.95
PROCESSING_SUMMARY_MAX_TOKENS=256
PROCESSING_PII_ENTITIES=["PERSON","EMAIL","PHONE_NUMBER","CREDIT_CARD","SSN","IP_ADDRESS"]

# --- Observability ---
OBSERVABILITY_PROMETHEUS_PORT=9090
OBSERVABILITY_METRICS_PATH=/metrics
OBSERVABILITY_ENABLE_TRACING=false
OBSERVABILITY_LANGSMITH_TRACING=false
OBSERVABILITY_LANGSMITH_API_KEY=
OBSERVABILITY_LANGSMITH_PROJECT=rag-ingestion
